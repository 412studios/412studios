generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String         @id @unique
  name                String?
  email               String         @unique
  role                String         @default("user")
  stripeCustomerId    String?        @unique
  verifyFormSubmitted Boolean        @default(false)
  isUserVerified      Boolean        @default(true)
  userBio             String?
  acceptedTerms       Boolean        @default(false)
  memberships         Memberships[]
  phone               String?
  socialLinks         String?
  categories          String?
  Bookings            Bookings[]
  Pricing             Pricing[]
}

model Bookings {
  bookingId       String     @id
  roomId          Int
  date            Int
  type            String     @default("hour")
  startTime       Int
  endTime         Int
  status          String     @default("pending")
  userId          String
  stripeProductId String
  totalHours      Int
  totalPrice      Float
  engineerTotal   Int
  engineerStart   Int
  engineerStatus  String
  addDetails      String
  offerCodeId     String?
  discountAmount  Float?     @default(0)
  createdAt       DateTime   @default(now())
  user            User       @relation(fields: [userId], references: [id])
  offerCode       OfferCode? @relation(fields: [offerCodeId], references: [id])
}

model Memberships {
  membershipId         String   @id @unique
  stripeSessionId      String
  stripeMembershipId   String
  interval             String
  status               String
  planId               String
  currentPeriodStart   Int
  currentPeriodEnd     Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt @map("updtedAt")
  roomId               Int
  availableHours       Int
  updateHours          DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id])
  userId               String
  weekMax              Boolean  @default(true)
}

model Pricing {
  id                String  @id @unique
  room              String
  dayRate           Int
  hourlyRate        Int
  img               String
  membershipPrice   Int
  engineerPrice     Int
  blocked           Boolean @default(false)
  User              User?   @relation(fields: [userId], references: [id])
  userId            String?
}

model OfferCode {
  id            String     @id @default(cuid())
  code          String     @unique
  description   String?
  discountType  String     // "percentage" or "fixed"
  discountValue Float      // percentage (e.g., 20 for 20%) or dollar amount (e.g., 20.00 for $20)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  bookings      Bookings[]
}
